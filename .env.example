# DeepSeek API配置 (V4 模型)
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_BETA_BASE_URL=https://api.deepseek.com/beta
# V4 Flash: 快速便宜，用于简单/中等任务
DEEPSEEK_MODEL_FLASH=deepseek-chat
# V4 Pro: 强力推理，用于复杂/极复杂任务
DEEPSEEK_MODEL_PRO=deepseek-reasoner
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=3

# 智能模型选择阈值
# 节点数超过此值自动使用 Pro
COMPLEXITY_THRESHOLD_NODES=40
# 扩展阶段超过此值自动使用 Pro
COMPLEXITY_THRESHOLD_STAGES=2

# 构建配置
MAX_NODES_PER_GRAPH=40
EXPAND_DOWN_DEFAULT=2
EXPAND_UP_DEFAULT=1
TEMPERATURE=0.0

# 路径配置
SEEDS_DIR=data/seeds
ARTIFACTS_DIR=artifacts
CACHE_DIR=.cache